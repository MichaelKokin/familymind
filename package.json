{
  "name": "family-mind-m0",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "lint": "eslint --no-warn-ignored src tests e2e scripts *.ts *.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "case:open": "node scripts/open-private-case.mjs",
    "case:launch": "node scripts/launch-family-mind.mjs",
    "case:audit": "node scripts/audit-private-case.mjs",
    "test:private": "node e2e/run-private.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "idb": "8.0.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^20.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "type": "module",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
